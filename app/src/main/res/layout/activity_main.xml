<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chill"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NHAC • Chill Mode"
        android:textColor="#0F766E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#D9FFFFFF"
        app:cardCornerRadius="84dp"
        app:cardElevation="6dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:contentDescription="Icon nhạc"
            android:src="@drawable/ic_music_note"
            app:tint="#0EA5E9" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="Chưa phát bài hát"
        android:textColor="#0F172A"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Chọn một giai điệu để thư giãn"
        android:textColor="#475569"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:progressBackgroundTint="#CBD5E1"
        android:progressTint="#0EA5E9"
        android:thumbTint="#0284C7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="#475569"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#475569"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Nút điều khiển phát nhạc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bài trước"
            android:src="@drawable/ic_prev"
            app:tint="#334155" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginHorizontal="18dp"
            android:background="@drawable/bg_play_button"
            android:contentDescription="Phát hoặc tạm dừng"
            android:src="@drawable/ic_play"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bài tiếp"
            android:src="@drawable/ic_next"
            app:tint="#334155" />

        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dừng hẳn"
            android:src="@drawable/ic_stop"
            app:tint="#F43F5E" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Danh sách phát"
        android:textColor="#1E293B"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvSongs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_chill"
        android:clipToPadding="false"
        android:divider="#1A0F172A"
        android:dividerHeight="1dp"
        android:padding="8dp" />

</LinearLayout>
